{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qkey:tls-reporter:observation:v1",
  "title": "Q-Key Evidence Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "assessment_id",
    "kind",
    "subject",
    "observed_at",
    "collector",
    "evidence",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "machine-observation",
        "customer-statement",
        "supplier-statement",
        "assumption",
        "analyst-inference"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "collector": {
      "type": "object",
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "enum": [
            "tool",
            "human"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "uri",
          "sha256"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "review_status": {
      "enum": [
        "unreviewed",
        "reviewed",
        "rejected"
      ]
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
